# Lokasi database SQLite (default: file:./dev.db).
DATABASE_URL="file:./dev.db"

# Telegram bot — notifikasi + command bot (server-only)
# Dapatkan token dari @BotFather (JANGAN commit token asli).
TELEGRAM_BOT_TOKEN=
# ID grup tujuan notifikasi (umumnya angka negatif untuk grup).
TELEGRAM_CHAT_ID=-100xxxxxxxxxx

# Comma-separated chat IDs yang boleh memakai command bot lewat webhook.
# Kalau kosong, fallback ke TELEGRAM_CHAT_ID.
TELEGRAM_ALLOWED_CHAT_IDS=

# Secret yg dipakai Telegram saat setWebhook (header validation).
# Buat string acak panjang, mis. `openssl rand -hex 32`.
TELEGRAM_WEBHOOK_SECRET=

# Secret untuk endpoint cron (/api/cron/daily-report).
# Kirim sebagai `Authorization: Bearer <token>` atau `?token=<token>`.
CRON_SECRET=

# Nama usaha untuk kop invoice PDF.
BUSINESS_NAME=Rekapal

# Kredensial akses dashboard web (username & password ditentukan di sini; kosongkan APP_PASSWORD untuk mode lokal tanpa login).
APP_USERNAME=admin
APP_PASSWORD=

# Secret HMAC untuk menandatangani cookie sesi login (opsional; disarankan set string acak panjang).
AUTH_SECRET=
