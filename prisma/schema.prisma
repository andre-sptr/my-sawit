generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

model DropdownOption {
  id        String   @id @default(cuid())
  group     String   // "maintenanceType" or "expenseCategory"
  value     String   // stored value (e.g. "SEMPROT", "GAJI_KARYAWAN")
  label     String   // display label (e.g. "Semprot", "Gaji karyawan")
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  @@unique([group, value])
  @@index([group])
}

model Kapling {
  id          String        @id @default(cuid())
  name        String        @unique
  isActive    Boolean       @default(true)
  harvests    Harvest[]
  maintenance Maintenance[]
  expenses    Expense[]
  sales       Sale[]
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
}

model Harvest {
  id          String   @id @default(cuid())
  kaplingId   String
  kapling     Kapling  @relation(fields: [kaplingId], references: [id], onDelete: Restrict)
  harvestDate DateTime
  weightKg    Float
  photoPath   String?
  note        String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([kaplingId, harvestDate])
}

model Maintenance {
  id           String   @id @default(cuid())
  kaplingId    String
  kapling      Kapling  @relation(fields: [kaplingId], references: [id], onDelete: Restrict)
  activityDate DateTime
  type         String
  cost         Float?
  photoPath    String?
  note         String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([kaplingId, activityDate])
}

model Expense {
  id          String   @id @default(cuid())
  kaplingId   String
  kapling     Kapling  @relation(fields: [kaplingId], references: [id], onDelete: Restrict)
  expenseDate DateTime
  category    String
  amount      Float
  photoPath   String?
  note        String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([kaplingId, expenseDate])
}

model Sale {
  id         String   @id @default(cuid())
  kaplingId  String
  kapling    Kapling  @relation(fields: [kaplingId], references: [id], onDelete: Restrict)
  saleDate   DateTime
  weightKg   Float
  pricePerKg Float
  photoPath  String?
  note       String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([kaplingId, saleDate])
}
